<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.client.MainController">

    <!-- ===== BARRA SUPERIORE ===== -->
    <top>
        <HBox style="-fx-background-color: #2c3e50; -fx-padding: 10 16 10 16;"
              alignment="CENTER_LEFT" spacing="0">
            <Label text="GuessTheWord"
                   style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnPartita"    text="Partita"    onAction="#mostraPartita"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13;" prefWidth="90"/>
            <Button fx:id="btnStorico"    text="Storico"    onAction="#mostraStorico"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13;" prefWidth="90"/>
            <Button fx:id="btnClassifica" text="Classifica" onAction="#mostraClassifica"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13;" prefWidth="100"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelUsername" style="-fx-text-fill: #BBDEFB; -fx-font-size: 12;"/>
        </HBox>
    </top>

    <center>
        <VBox style="-fx-padding: 20;">

            <!-- ===== PANNELLO PARTITA ===== -->
            <VBox fx:id="panelPartita" spacing="18" alignment="CENTER">
                <Label text="Seleziona difficoltà:" style="-fx-font-size: 14;"/>
                <VBox spacing="8" alignment="CENTER_LEFT" style="-fx-padding: 0 0 0 200;">
                    <RadioButton fx:id="rbFacile"    text="Facile    (60 sec)"/>
                    <RadioButton fx:id="rbMedio"     text="Medio     (40 sec)"/>
                    <RadioButton fx:id="rbDifficile" text="Difficile (20 sec)"/>
                </VBox>
                <Button text="AVVIA PARTITA" onAction="#avviaPartita"
                        prefWidth="180" prefHeight="40"
                        style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
                <Label fx:id="statoPartitaLabel" text="" style="-fx-text-fill: #555; -fx-font-size: 12;"/>
            </VBox>

            <!-- ===== PANNELLO GIOCO ===== -->
            <VBox fx:id="panelGioco" spacing="16" alignment="CENTER"
                  visible="false" managed="false">
                <HBox alignment="CENTER_RIGHT">
                    <Label fx:id="labelTimer" text="00:00"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #C62828;"/>
                </HBox>
                <Label text="Trova la parola cifrata:" style="-fx-font-size: 13;"/>
                <Label fx:id="labelTestoSfida" text=""
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #C62828;
                              -fx-background-color: #FFEBEE; -fx-padding: 14 28 14 28;
                              -fx-border-color: #EF9A9A; -fx-border-radius: 4;" wrapText="true"/>
                <Label fx:id="labelEsito" text="" style="-fx-font-size: 13; -fx-text-fill: #1565C0;"/>
                <HBox spacing="10" alignment="CENTER">
                    <TextField fx:id="inputRisposta" promptText="Inserisci la parola..."
                               prefWidth="260" style="-fx-font-size: 14;"/>
                    <Button fx:id="btnOk" text="OK" onAction="#inviaRisposta"
                            prefWidth="60"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>
                <Button fx:id="btnGiocaAncora" text="GIOCA ANCORA" onAction="#giocaAncora"
                        visible="false" prefWidth="180" prefHeight="36"
                        style="-fx-background-color: #C62828; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </VBox>

            <!-- ===== PANNELLO STORICO ===== -->
            <VBox fx:id="panelStorico" spacing="10" visible="false" managed="false">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Cerca avversario:"/>
                    <TextField fx:id="cercaStorico" promptText="Username..." prefWidth="200"/>
                </HBox>
                <TableView fx:id="storicoTable" prefHeight="460">
                    <columns>
                        <TableColumn fx:id="colStData"       text="Data"       prefWidth="150"/>
                        <TableColumn fx:id="colStAvversario" text="Avversario" prefWidth="180"/>
                        <TableColumn fx:id="colStRisultato"  text="Risultato"  prefWidth="120"/>
                    </columns>
                    <placeholder><Label text="Nessuna partita."/></placeholder>
                </TableView>
            </VBox>

            <!-- ===== PANNELLO CLASSIFICA ===== -->
            <VBox fx:id="panelClassifica" spacing="10" visible="false" managed="false">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Cerca giocatore:"/>
                    <TextField fx:id="cercaClassifica" promptText="Username..." prefWidth="200"/>
                </HBox>
                <TableView fx:id="classificaTable" prefHeight="460">
                    <columns>
                        <TableColumn fx:id="colClPosizione" text="#"          prefWidth="40"/>
                        <TableColumn fx:id="colClUsername"  text="Giocatore"  prefWidth="160"/>
                        <TableColumn fx:id="colClVittorie"  text="Vittorie"   prefWidth="80"/>
                        <TableColumn fx:id="colClSconfitte" text="Sconfitte"  prefWidth="80"/>
                        <TableColumn fx:id="colClPareggi"   text="Pareggi"    prefWidth="80"/>
                        <TableColumn fx:id="colClTempo"     text="Tempo medio (ms)" prefWidth="140"/>
                    </columns>
                    <placeholder><Label text="Nessun giocatore."/></placeholder>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>