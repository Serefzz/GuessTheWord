@startuml
title Persistenza - DAO

interface DAO<T> {
    + selectAll(): List<T>
    + selectById(id: int): Optional<T>
    + insert(t: T): boolean
    + update(t: T): boolean
    + delete(id: int): boolean
}

class DatabaseManager {
    + {static} URL: String
    - DatabaseManager()
    + {static} inizializza(): void
}

class RisultatoPartita {
    - id: int
    - giocatore1: String
    - giocatore2: String
    - vincitore: String
    - data: String
    - tempoRisposta: long
    + getGiocatore1(): String
    + getGiocatore2(): String
    + getVincitore(): String
    + getData(): String
    + getTempoRisposta(): long
}

class UtenteDAO {
    + registra(username: String, password: String): boolean
    + verificaLogin(username: String, password: String): boolean
    + getClassifica(): List<String[]>
    + isAdmin(username: String): boolean
    + {static} hashPassword(password: String): String
}

class PartitaDAO {
    + salva(g1: String, g2: String, vincitore: String, tempo: long): void
    + getStorico(username: String): List<String[]>
    + selectAll(): List<RisultatoPartita>
}

class Utente {
    - id: int
    - username: String
    - password: String
    - ruolo: Ruolo
    + getUsername(): String
    + getRuolo(): Ruolo
}

DAO <|.. UtenteDAO
DAO <|.. PartitaDAO
PartitaDAO --> RisultatoPartita
UtenteDAO --> DatabaseManager 
PartitaDAO --> DatabaseManager 

@enduml